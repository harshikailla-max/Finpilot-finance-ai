# ==============================================================================
# FINPILOT AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' (do NOT commit .env to source control).
# 2. Populate your secret API keys below.
# 3. For local execution: run 'python server.py' to serve API & Web securely.
# 4. For Vercel deployment: add these environment variables in your Vercel Project Settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI COACH (Google Gemini API)
# ------------------------------------------------------------------------------
# Provider: Google Generative AI (Gemini)
# Endpoint: https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash
# How to get a key: https://aistudio.google.com/app/apikey
# If left empty, FinPilot will automatically run its built-in on-device
# deterministic financial intelligence engine without failing or crashing.
FINPILOT_AI_API_KEY=

# Optional fallback compatibility variable name for Gemini API key:
# GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. AZURE AI DOCUMENT INTELLIGENCE (Receipt OCR Engine - Free F0 Tier)
# ------------------------------------------------------------------------------
# Provider: Azure AI Document Intelligence (Prebuilt Receipt Model)
# Model: prebuilt-receipt (API Version 2024-11-30 / 2023-07-31)
# Free Tier (F0): 20 pages/month, 20 calls/minute, max 4 MB file size.
# How to get:
#   1. Sign in to Azure Portal (https://portal.azure.com)
#   2. Create a "Document Intelligence" resource under the free "F0" pricing tier.
#   3. Copy your Endpoint and Key from "Keys and Endpoint" under Resource Management.
#
# Azure Document Intelligence Endpoint:
# Example: https://finpilot-receipts.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=

# Azure Document Intelligence Key:
# 32-character hexadecimal key (e.g. 0123456789abcdef0123456789abcdef)
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# ------------------------------------------------------------------------------
# 3. RECEIPT OCR FALLBACK (OCR.space API)
# ------------------------------------------------------------------------------
# Provider: OCR.space Free / Pro Web API (Secondary Fallback)
# Endpoint: https://api.ocr.space/parse/image
# How to get a free key: https://ocr.space/ocrapi/freekey
# If left empty, FinPilot will use the internal OCR pipeline or QR parsing fallback.
FINPILOT_OCR_API_KEY=

# ------------------------------------------------------------------------------
# 3. SERVER & DEPLOYMENT CONFIGURATION
# ------------------------------------------------------------------------------
# Local port for Python development server (default 8088)
PORT=8088

# Optional custom backend URL (leave empty when running unified server or Vercel)
# FINPILOT_BACKEND_URL=
